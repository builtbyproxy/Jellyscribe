// Telemetry ingest worker + D1 database.
// Deploy:  npx wrangler deploy            (from this directory)
// Schema:  npx wrangler d1 execute lbsync-telemetry --remote --file schema.sql
// Secret:  npx wrangler secret put INGEST_KEY   (the publishable write key baked
//          into the plugin; extractable by design, junk rows at worst)
{
  "name": "lbsync-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lbsync-telemetry",
      "database_id": "b63431fa-3cc5-4ee0-9d65-93841dd30dcc"
    }
  ],
  "triggers": {
    "crons": ["13 3 * * *"]
  },
  // Workers Logs stays OFF. Its invocation logs record request metadata for
  // every call, which would put caller IPs from every public manifest poll and
  // download into Cloudflare's log store, and the README promises IPs are only
  // used transiently. The setting is Worker-wide (no per-route sampling), so it
  // cannot be kept for POST routes alone. To debug, use `npx wrangler tail`
  // (live, not persisted) rather than turning this back on.
  "observability": {
    "enabled": false
  }
}
