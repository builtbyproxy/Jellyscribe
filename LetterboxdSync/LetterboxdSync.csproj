<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Overridable so CI can probe a Jellyfin 12 build without touching what we ship.
         Defaults ARE the shipping configuration: net9.0 against SDK 10.11.9 (== targetAbi.txt).
         Override together, never singly: the 12.x SDK packages ship lib/net10.0 only, so
         -p:JellyfinSdkVersion=12.1.0 without -p:PluginTargetFramework=net10.0 fails to restore
         (NU1202). Note the framework knob is PluginTargetFramework, not TargetFramework:
         TargetFramework is special-cased by the SDK for inner/outer builds and does not reliably
         override on a solution-level restore (proven: the first probe run still resolved net9.0).
         See openspec/changes/add-jellyfin-12-support/. -->
    <PluginTargetFramework Condition="'$(PluginTargetFramework)' == ''">net9.0</PluginTargetFramework>
    <TargetFramework>$(PluginTargetFramework)</TargetFramework>
    <JellyfinSdkVersion Condition="'$(JellyfinSdkVersion)' == ''">10.11.9</JellyfinSdkVersion>
    <DataProtectionVersion Condition="'$(DataProtectionVersion)' == ''">9.0.0</DataProtectionVersion>
    <AssemblyName>Jellyscribe</AssemblyName>
    <RootNamespace>LetterboxdSync</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyVersion>2.4.2.0</AssemblyVersion>
    <FileVersion>2.4.2.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LetterboxdSync.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.6.11" />
    <!-- FLOOR POLICY: Jellyfin assemblies carry full per-patch AssemblyVersions, so the
         SDK version we compile against IS the minimum Jellyfin a release can load on
         (strict binding; proven live on 10.11.10 with a 10.11.11-built DLL, issue #63).
         These MUST equal targetAbi.txt and only move together, deliberately, when we
         need a newer API - never via a routine dependency bump. CI enforces the match. -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinSdkVersion)" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinSdkVersion)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Encrypts stored secrets (Letterboxd password/cookies, Seerr API key) at rest.
         See LetterboxdSync/Security/SecretProtector.cs for the threat model. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="$(DataProtectionVersion)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\configPage.html" />
    <EmbeddedResource Include="Web\configPage.js" />
    <EmbeddedResource Include="Web\statsPage.html" />
    <EmbeddedResource Include="Web\userPage.html" />
    <EmbeddedResource Include="Web\sidebar.js" />
  </ItemGroup>

</Project>
