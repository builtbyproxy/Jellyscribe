<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Jellyscribe</AssemblyName>
    <RootNamespace>LetterboxdSync</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyVersion>2.13.0.0</AssemblyVersion>
    <FileVersion>2.13.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LetterboxdSync.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.6.11" />
    <!-- FLOOR POLICY: Jellyfin assemblies carry full per-patch AssemblyVersions, so the
         SDK version we compile against IS the minimum Jellyfin a release can load on
         (strict binding; proven live on 10.11.10 with a 10.11.11-built DLL, issue #63).
         These MUST equal targetAbi.txt and only move together, deliberately, when we
         need a newer API - never via a routine dependency bump. CI enforces the match. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.9" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Encrypts stored secrets (Letterboxd password/cookies, Seerr API key) at rest.
         See LetterboxdSync/Security/SecretProtector.cs for the threat model. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\sidebar.js" />
    <EmbeddedResource Include="Web\jellyscribe.css" />
    <!-- Both dashboards load jellyscribe.js/.css with ?v=<this build's version>, and jellyscribe.js
         registers itself under the same version, so these three are embedded from copies with the
         version stamped in (StampWebAssetVersion below). -->
    <VersionedWebAsset Include="Web\configPage.html;Web\userPage.html;Web\jellyscribe.js" />
    <EmbeddedResource Include="@(VersionedWebAsset->'$(IntermediateOutputPath)web\%(Filename)%(Extension)')" LogicalName="LetterboxdSync.Web.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Copies a file with @@JELLYSCRIBE_VERSION@@ replaced, byte for byte otherwise, and leaves the copy
       untouched when it would not change. -->
  <UsingTask TaskName="StampVersion" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = System.IO.File.ReadAllText(Source).Replace("@@JELLYSCRIBE_VERSION@@", Version);
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Destination));
        if (!System.IO.File.Exists(Destination) || System.IO.File.ReadAllText(Destination) != text)
            System.IO.File.WriteAllText(Destination, text, new System.Text.UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- A Debug build (deploy.sh) keeps the release's version, so its stamp gets "-dev": the server then
       never lets a browser cache it for good, and a redeployed debug build is picked up. -->
  <PropertyGroup>
    <WebAssetVersion>$(AssemblyVersion)</WebAssetVersion>
    <WebAssetVersion Condition="'$(Configuration)' == 'Debug'">$(AssemblyVersion)-dev</WebAssetVersion>
  </PropertyGroup>

  <Target Name="StampWebAssetVersion" BeforeTargets="BeforeBuild">
    <StampVersion Source="%(VersionedWebAsset.FullPath)" Destination="$(IntermediateOutputPath)web\%(VersionedWebAsset.Filename)%(VersionedWebAsset.Extension)" Version="$(WebAssetVersion)" />
  </Target>

</Project>
